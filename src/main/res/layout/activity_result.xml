<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F8FF">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- タイトル -->
        <TextView
            android:text="L♡VEスポットくまちゃん先生"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FF4081"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="ここはどうですか？"
            android:textSize="16sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Spot 1 -->
        <LinearLayout
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:background="@android:color/white"
            android:elevation="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/selectedConditionsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="条件がここに表示されます" />
            <TextView
                android:id="@+id/spotNameText"
                android:text="1. スポットの名前"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <ImageView
                android:id="@+id/spotImage"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"

                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="8dp"
                />
            <TextView
                android:id="@+id/imageStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="画像の状態がここに表示されます"
                android:layout_marginTop="8dp"
                android:textColor="#666666" />
            <Button
                android:id="@+id/button_view_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="詳細を見る"
                android:layout_marginTop="16dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>